<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SmkMart.Mobile</RootNamespace>
    <AssemblyName>SmkMart.Android</AssemblyName>

    <ApplicationTitle>SMK MART</ApplicationTitle>
    <ApplicationId>com.smkmart.kasir</ApplicationId>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <!-- Hasil build berupa .apk (bukan .aab) agar bisa langsung dipasang / dibagikan -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#17382B" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#17382B" BaseSize="160,160" />
  </ItemGroup>

  <!-- Logika data dipakai bersama versi Windows (tidak disalin, hanya ditautkan) -->
  <ItemGroup>
    <Compile Include="..\SmkMart\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\SmkMart\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SmkMart.Models" />
    <Using Include="SmkMart.Services" />
  </ItemGroup>

</Project>
